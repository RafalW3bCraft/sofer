# sofer — environment configuration
# Copy this file to `.env` in the repo root and fill in real values.
# Never commit a real `.env`.

# --- AMD Token Factory (optional) ---
# Without these, the AI tutor endpoint serves the curated fallback and the UI
# shows an "AI tutor unavailable" status pill. Lessons and progress work
# without them.

# Your Token Factory API key. Required for live AI tutor calls. Never
# commit this value.
TOKENFACTORY_API_KEY=

# Base URL for Token Factory's OpenAI-compatible API.
#
# Two endpoints are documented as of 2026-10-23:
#   - https://developer.amd.com.cn/radeon/api/v1  — the China-site / Radeon
#     Cloud public endpoint. AMD documentation describes this as development
#     and trial use; some accounts may not have access.
#   - https://api.tokenfactory.nebius.com/v1      — the Nebius-region Token
#     Factory endpoint used for the live hackathon credential.
#
# Pick the one that matches your account. Both endpoints speak the
# OpenAI-compatible `/v1/models` and `/v1/chat/completions` shape sofer
# already targets.
TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model ID to use. Resolve against `GET ${TOKENFACTORY_BASE_URL}/models` once
# you have a real key. Common example for the Nebius endpoint:
#   Qwen/Qwen3-235B-A22B-Instruct-2507
# Common example for the AMD China endpoint:
#   DeepSeek-V4-Flash
TOKENFACTORY_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Outbound timeout in milliseconds.
TOKENFACTORY_TIMEOUT_MS=30000

# --- Server (optional) ---
# Override the default Express port.
PORT=3001