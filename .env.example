# sofer — environment configuration
# Copy this file to `.env` in the repo root and fill in real values.
# Never commit a real `.env`.

# --- Token Factory AI provider (optional) ---
# Without these, the AI tutor endpoint serves the curated fallback and the UI
# shows an "AI tutor unavailable" status pill. Lessons and progress work
# without them.
#
# IMPORTANT: "Nebius Token Factory" and "AMD Radeon Cloud Token Factory" are
# TWO DIFFERENT PROVIDERS with separate accounts and keys. A key issued by
# one returns 401 at the other (verified 2026-10-23: the hackathon key is a
# Nebius key and is rejected by the AMD China endpoint). They are not
# regions of one service.

# Your Token Factory API key. Required for live AI tutor calls. Never
# commit this value.
TOKENFACTORY_API_KEY=

# Base URL for the provider's OpenAI-compatible API.
#
#   - https://api.tokenfactory.nebius.com/v1      — Nebius Token Factory.
#     This is the provider the verified live hackathon credential belongs
#     to, and the server default.
#   - https://developer.amd.com.cn/radeon/api/v1  — AMD Radeon Cloud Token
#     Factory (China site). A separate provider; requires its own AMD-issued
#     key. AMD documentation describes it as development / trial use.
#
# Pick the one that matches the account that issued your key. Both speak the
# OpenAI-compatible `/v1/models` and `/v1/chat/completions` shape sofer
# already targets.
TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model ID to use. Resolve against `GET ${TOKENFACTORY_BASE_URL}/models` once
# you have a real key. Common example for the Nebius endpoint:
#   Qwen/Qwen3-235B-A22B-Instruct-2507
# Common example for the AMD China endpoint:
#   DeepSeek-V4-Flash
TOKENFACTORY_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Outbound timeout in milliseconds.
TOKENFACTORY_TIMEOUT_MS=30000

# --- Server (optional) ---
# Override the default Express port.
PORT=3001